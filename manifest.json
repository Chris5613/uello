{
  "manifest_version": 3,
  "name": "Tello Line Dashboard",
  "version": "1.0.0",
  "description": "Scans Tello account phone lines and shows a combined dashboard.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://tello.com/*",
        "https://www.tello.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ]
}